<mapper namespace="com.example.kzjzdatabase.mapper.Special_IndexMapper">
    <resultMap id="BaseResultMap" type="com.example.kzjzdatabase.entity.Special_Index">
        <result column="id" jdbcType="VARCHAR" property="id"/>
        <result column="showflag" jdbcType="INTEGER" property="showflag"/>
        <result column="ofname" jdbcType="VARCHAR" property="ofname"/>
        <result column="resume" jdbcType="VARCHAR" property="resume"/>
        <result column="ids" jdbcType="VARCHAR" property="ids"/>
